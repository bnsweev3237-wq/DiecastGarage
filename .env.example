# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the Stripe webhook to record memberships. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The site's public address, used for sign-up emails and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: Developers > API keys, and the recurring Price for the membership
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MEMBERSHIP_PRICE_ID=price_...

# Protects the daily photo cleanup job (/api/cron/cleanup-photos). Any long random string; Vercel sends it automatically.
CRON_SECRET=a-long-random-string

# Cloudflare Turnstile bot check on sign-up and sign-in (free). Site key here; the secret key goes in
# Supabase: Authentication → Attack Protection → Enable CAPTCHA protection → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Notification emails through Resend (resend.com). Leave blank to keep emails off.
RESEND_API_KEY=
EMAIL_FROM="theCollectorHQ <notifications@thecollectorhq.com>"
